<?xml version="1.0" encoding="utf-8"?>
<!-- Repo-local package source (the test project needs xunit). The app and engine have no NuGet dependencies. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
