<Window x:Class="GordonGeoSteer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:GordonGeoSteer.ViewModels"
        xmlns:ctl="clr-namespace:GordonGeoSteer.Controls"
        xmlns:views="clr-namespace:GordonGeoSteer.Views"
        Title="GordonGeoSteer - PZS project browser and steering view" Height="820" Width="1360"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="12">
    <Window.InputBindings>
        <KeyBinding Key="S" Modifiers="Control" Command="ApplicationCommands.Save" />
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Save" Executed="SaveWorkspace_Click" />
    </Window.CommandBindings>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="Title" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Sub" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,6,0,4" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="#444" />
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#E4E4E4" />
            <Setter Property="AlternatingRowBackground" Value="#F7F9FC" />
            <Setter Property="EnableRowVirtualization" Value="True" />
        </Style>

        <!-- reusable key/value property sheet -->
        <DataTemplate x:Key="KvGrid">
            <DataGrid ItemsSource="{Binding}" HeadersVisibility="None" MaxHeight="420">
                <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding Key}" FontWeight="SemiBold" Width="Auto" />
                    <DataGridTextColumn Binding="{Binding Value}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /></Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </DataTemplate>

        <!-- ============ detail views, selected by view-model type ============ -->
        <DataTemplate DataType="{x:Type vm:ProjectDetailViewModel}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Title}" Text="{Binding Title}" />
                <ContentControl Content="{Binding Rows}" ContentTemplate="{StaticResource KvGrid}" VerticalAlignment="Top" />
            </DockPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ErrorViewModel}">
            <StackPanel>
                <TextBlock Style="{StaticResource Title}" Foreground="DarkRed" Text="{Binding Title, StringFormat='Error displaying {0}'}" />
                <TextBox Text="{Binding Message, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ImportReportViewModel}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Title}" Text="{Binding Title}" />
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Sub}" Text="{Binding Summary}" FontWeight="SemiBold" />
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Sub}" Text="Warnings:" />
                <ListBox DockPanel.Dock="Top" ItemsSource="{Binding Warnings}" MaxHeight="90" Foreground="#8A5A00">
                    <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" /></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Sub}" Text="Cross-checks (importer validation of decoded data against independent sources):" />
                <Expander DockPanel.Dock="Bottom" Header="Importer console log" Margin="0,6,0,0">
                    <TextBox Text="{Binding ImporterLog, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" MaxHeight="220"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                </Expander>
                <DataGrid ItemsSource="{Binding CrossChecks}">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Pass}" Value="False">
                                    <Setter Property="Background" Value="#FFD9D9" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="Pass" Binding="{Binding Pass, Mode=OneWay}" />
                        <DataGridTextColumn Header="Check" Binding="{Binding Check}" Width="280" />
                        <DataGridTextColumn Header="Subject" Binding="{Binding Subject}" Width="320" />
                        <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:WellDetailViewModel}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Title}" Text="{Binding Title}" />
                <ContentControl DockPanel.Dock="Top" Content="{Binding Rows}" ContentTemplate="{StaticResource KvGrid}" />
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Sub}" Text="Header attributes (LAS-style sections as stored in the PZS well database):" />
                <DataGrid ItemsSource="{Binding HeaderAttributes}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Section" Binding="{Binding SectionName}" />
                        <DataGridTextColumn Header="Mnemonic" Binding="{Binding Mnemonic}" />
                        <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" />
                        <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="200" />
                        <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:SurveyViewModel}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Title}" Text="{Binding Title}" />
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Sub}" Text="{Binding Summary}" />
                <DataGrid ItemsSource="{Binding Stations}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="MD" Binding="{Binding Md, StringFormat=0.00}" />
                        <DataGridTextColumn Header="Inc (deg)" Binding="{Binding Inclination, StringFormat=0.00}" />
                        <DataGridTextColumn Header="Azi (deg)" Binding="{Binding Azimuth, StringFormat=0.00}" />
                        <DataGridTextColumn Header="Type" Binding="{Binding TypeName}" />
                        <DataGridTextColumn Header="N" Binding="{Binding North, StringFormat=0.00, TargetNullValue=-}" />
                        <DataGridTextColumn Header="E" Binding="{Binding East, StringFormat=0.00, TargetNullValue=-}" />
                        <DataGridTextColumn Header="TVD" Binding="{Binding Tvd, StringFormat=0.00, TargetNullValue=-}" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:CurveListViewModel}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Title}" Text="{Binding Title}" />
                <DataGrid ItemsSource="{Binding Curves}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" FontWeight="SemiBold" />
                        <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" />
                        <DataGridTextColumn Header="Unit" Binding="{Binding ValueUnit}" />
                        <DataGridTextColumn Header="Records" Binding="{Binding RecordCount}" />
                        <DataGridTextColumn Header="Cols" Binding="{Binding ColumnCount}" />
                        <DataGridTextColumn Header="Depth start" Binding="{Binding DepthStart, StringFormat=0.####}" />
                        <DataGridTextColumn Header="Depth stop" Binding="{Binding DepthStop, StringFormat=0.####}" />
                        <DataGridTextColumn Header="Min" Binding="{Binding ValueMin, StringFormat=0.####}" />
                        <DataGridTextColumn Header="Max" Binding="{Binding ValueMax, StringFormat=0.####}" />
                        <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:CurveViewModel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="380" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.ColumnSpan="2" Style="{StaticResource Title}" Text="{Binding Title}" />
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,4">
                    <CheckBox x:Name="logChk" Content="Log scale (value axis)" IsChecked="{Binding LogScaleDefault, Mode=OneTime}" />
                    <TextBlock Margin="16,0,0,0" Foreground="DarkRed" Text="{Binding LoadError}" />
                </StackPanel>
                <Border Grid.Row="2" BorderBrush="#CCC" BorderThickness="1">
                    <ctl:CurvePlot XValues="{Binding Md}" YValues="{Binding Values}" LogScale="{Binding IsChecked, ElementName=logChk}"
                                   XLabel="{Binding DepthAxisLabel}" YLabel="{Binding ValueAxisLabel}" MinHeight="300" />
                </Border>
                <ContentControl Grid.Row="1" Grid.RowSpan="2" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Top"
                                Content="{Binding Rows}" ContentTemplate="{StaticResource KvGrid}" />
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ModelDetailViewModel}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Title}" Text="{Binding Title}" />
                <ContentControl Content="{Binding Rows}" ContentTemplate="{StaticResource KvGrid}" VerticalAlignment="Top" />
            </DockPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:TargetsViewModel}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Title}" Text="{Binding Title}" />
                <DataGrid ItemsSource="{Binding Targets}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" FontWeight="SemiBold" />
                        <DataGridTextColumn Header="North" Binding="{Binding North, StringFormat=0.00}" />
                        <DataGridTextColumn Header="East" Binding="{Binding East, StringFormat=0.00}" />
                        <DataGridTextColumn Header="TVD" Binding="{Binding Tvd, StringFormat=0.00}" />
                        <DataGridTextColumn Header="Inc (deg)" Binding="{Binding InclinationDeg, StringFormat=0.00}" />
                        <DataGridTextColumn Header="Azi (deg)" Binding="{Binding AzimuthDeg, StringFormat=0.00}" />
                        <DataGridTextColumn Header="Path type" Binding="{Binding PathType}" />
                        <DataGridTextColumn Header="Target DLS/unit" Binding="{Binding TargetDoglegPerUnitLength}" />
                        <DataGridTextColumn Header="Max DLS/unit" Binding="{Binding MaxDoglegPerUnitLength}" />
                        <DataGridCheckBoxColumn Header="Active" Binding="{Binding Active, Mode=OneWay}" />
                        <DataGridTextColumn Header="Nearest MD" Binding="{Binding NearestMd, StringFormat=0.00}" />
                        <DataGridTextColumn Header="Dist. from path" Binding="{Binding DistanceFromWellPath, StringFormat=0.00}" />
                        <DataGridTextColumn Header="Unit" Binding="{Binding LengthUnit}" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:GeologyViewModel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="2*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="3*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.ColumnSpan="2" Style="{StaticResource Title}" Text="{Binding Title}" />
                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource Sub}" Text="{Binding Summary}" />
                <DataGrid Grid.Row="2" Grid.ColumnSpan="2" ItemsSource="{Binding Beds}" SelectedItem="{Binding SelectedBed, Mode=TwoWay}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Category" Binding="{Binding Category}" />
                        <DataGridTextColumn Header="Bed name" Binding="{Binding Name}" FontWeight="SemiBold" Width="180" />
                        <DataGridTextColumn Header="Bed type" Binding="{Binding BedType}" />
                        <DataGridTextColumn Header="Geo type" Binding="{Binding GeoType}" />
                        <DataGridTextColumn Header="Source MD" Binding="{Binding SourceWellMd, StringFormat=0.###}" />
                        <DataGridTextColumn Header="RVD" Binding="{Binding Rvd, StringFormat=0.###}" />
                        <DataGridTextColumn Header="Depth index" Binding="{Binding DepthIndex, StringFormat=0.###}" />
                        <DataGridTextColumn Header="Grid (E x N)" Binding="{Binding GridSize}" />
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Style="{StaticResource Sub}" FontWeight="SemiBold" Text="{Binding GridSummary}" />
                <Border Grid.Row="4" BorderBrush="#CCC" BorderThickness="1" Margin="0,0,4,0">
                    <ctl:GridHeatmap Grid="{Binding SelectedGrid}" MinHeight="220" />
                </Border>
                <DataGrid Grid.Row="4" Grid.Column="1" Margin="4,0,0,0" ItemsSource="{Binding GridRows}"
                          ctl:DataGridColumnsBehavior.CellHeaders="{Binding GridColumnHeaders}" />
                <Expander Grid.Row="5" Grid.ColumnSpan="2" Header="{Binding SteeringSummary}" Margin="0,6,0,0">
                    <DataGrid ItemsSource="{Binding Steering}" MaxHeight="200">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="MD" Binding="{Binding Md, StringFormat=0.####}" />
                            <DataGridTextColumn Header="Delta TVD per bed" Binding="{Binding DeltaTvd}" Width="260" />
                            <DataGridTextColumn Header="Slope per bed (dimensionless)" Binding="{Binding Slope}" Width="260" />
                            <DataGridTextColumn Header="Fault throw" Binding="{Binding FaultThrow}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Expander>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:InventoryViewModel}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Title}" Text="{Binding Title}" />
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Sub}" Text="{Binding Summary}" />
                <DataGrid ItemsSource="{Binding Files}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="330" />
                        <DataGridTextColumn Header="Category" Binding="{Binding Category}" />
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" FontWeight="SemiBold" />
                        <DataGridTextColumn Header="Size (bytes)" Binding="{Binding SizeBytes}" />
                        <DataGridTextColumn Header="Duplicate of" Binding="{Binding DuplicateOf}" Width="230" />
                        <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Open PZS Project Folder (import)..." Click="OpenPzsFolder_Click" />
                <MenuItem Header="Open _Imported project.json..." Click="OpenJson_Click" />
                <Separator />
                <MenuItem Header="E_xit" Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="_Steering" IsEnabled="{Binding HasSteering}">
                <MenuItem Header="_Show steering view" Click="ShowSteering_Click" />
                <Separator />
                <MenuItem Header="_Save workspace" Click="SaveWorkspace_Click" InputGestureText="Ctrl+S" />
                <MenuItem Header="Save workspace _as..." Click="SaveWorkspaceAs_Click" />
                <MenuItem Header="_Load workspace..." Click="LoadWorkspace_Click" />
                <MenuItem Header="_Reset layout to defaults" Click="ResetWorkspace_Click" />
                <Separator />
                <MenuItem Header="Run engine _validation..." Click="Validation_Click" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_Dump loaded data (debug)..." Click="Dump_Click" />
                <MenuItem Header="_About" Click="About_Click" />
            </MenuItem>
        </Menu>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <ProgressBar Width="120" Height="12" IsIndeterminate="True"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" />
            </StatusBarItem>
        </StatusBar>

        <Border DockPanel.Dock="Top" Padding="8,5" Visibility="{Binding HasBanner, Converter={StaticResource BoolToVis}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#FFF4D6" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding BannerIsError}" Value="True">
                            <Setter Property="Background" Value="#FFD9D9" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding Banner}" TextWrapping="Wrap" FontWeight="SemiBold" />
        </Border>

        <Expander DockPanel.Dock="Bottom" Header="Importer output" x:Name="logExpander">
            <TextBox x:Name="logBox" Text="{Binding ImportLog, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" Height="160"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextChanged="LogBox_TextChanged" />
        </Expander>

        <TabControl x:Name="mainTabs" Padding="0">
        <TabItem Header="Browse">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" MinWidth="200" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TreeView x:Name="tree" ItemsSource="{Binding Nodes}" SelectedItemChanged="Tree_SelectedItemChanged">
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                    </Style>
                </TreeView.ItemContainerStyle>
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate DataType="{x:Type vm:TreeNode}" ItemsSource="{Binding Children}">
                        <TextBlock Text="{Binding Header}" />
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
            <TextBlock Margin="12" Foreground="#777" TextWrapping="Wrap" IsHitTestVisible="False"
                       Text="No project loaded. Use File > Open PZS Project Folder (import)... to run the importer on a PZS project folder, or File > Open Imported project.json... to reopen a previous import.">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Nodes.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#E0E0E0" />
            <ContentControl x:Name="detailHost" Grid.Column="2" Margin="10" Content="{Binding SelectedDetail}" />
        </Grid>
        </TabItem>
        <TabItem Header="Steering view" x:Name="steeringTab">
            <Grid>
                <views:SteeringView x:Name="steeringView" DataContext="{Binding Steering}"
                                    Visibility="{Binding DataContext.HasSteering, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
                <TextBox Text="{Binding SteeringMessage, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Margin="12"
                         Foreground="#555" Background="Transparent">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSteering}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
            </Grid>
        </TabItem>
        </TabControl>
    </DockPanel>
</Window>
